<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:focusableInTouchMode="true">
    <Toolbar android:id="@+id/barra" android:layout_width="match_parent" android:layout_height="?android:attr/actionBarSize"
        android:background="@color/papel" android:titleTextColor="@color/texto"/>
    <TextView android:id="@+id/subtitulo" style="@style/Rotulo" android:paddingStart="16dp"
        android:paddingEnd="16dp" android:paddingTop="12dp" android:textStyle="bold"/>
    <LinearLayout android:id="@+id/filtros" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:orientation="vertical" android:visibility="gone">
        <EditText android:id="@+id/pesquisa" style="@style/Campo" android:hint="Pesquisar produto" android:inputType="text"/>
        <Spinner android:id="@+id/categoria" android:layout_width="match_parent" android:layout_height="48dp"
            android:contentDescription="Filtrar por categoria"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/progresso" style="?android:attr/progressBarStyleHorizontal"
        android:indeterminate="true" android:layout_width="match_parent" android:layout_height="4dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@color/linha" android:dividerHeight="1dp"/>
        <GridView android:id="@+id/grade" android:layout_width="match_parent" android:layout_height="match_parent"
            android:numColumns="2" android:padding="16dp" android:verticalSpacing="8dp" android:horizontalSpacing="12dp"
            android:stretchMode="columnWidth" android:visibility="gone"/>
        <TextView android:id="@+id/vazio" style="@style/Rotulo" android:layout_gravity="center" android:gravity="center"
            android:padding="16dp" android:textColor="@color/secundario"/>
    </FrameLayout>
    <TextView android:id="@+id/situacao_rede" style="@style/Rotulo" android:paddingHorizontal="16dp"
        android:textSize="13sp" android:textColor="@color/secundario" android:accessibilityLiveRegion="polite"/>
    <LinearLayout android:id="@+id/acoes" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingBottom="8dp">
        <Button android:id="@+id/principal" style="@style/Acao" android:visibility="gone"/>
        <Button android:id="@+id/secundaria" style="@style/Acao" android:backgroundTint="#EDF2FF"
            android:layout_marginTop="6dp" android:textColor="@color/azul" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
