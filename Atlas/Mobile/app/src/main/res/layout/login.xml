<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/login">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:focusableInTouchMode="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="112dp">
            <Toolbar android:id="@+id/barra" android:layout_width="64dp" android:layout_height="?android:attr/actionBarSize"
                android:layout_gravity="top|end" android:theme="@android:style/Theme.Material"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="24dp">
            <ImageView android:layout_width="match_parent" android:layout_height="74dp"
                android:layout_marginBottom="20dp" android:scaleType="fitCenter"
                android:src="@drawable/marca_atlas_branca" android:contentDescription="ATLAS"/>
            <EditText android:id="@+id/codigo" style="@style/Campo" android:background="@drawable/campo_login"
                android:hint="Código do funcionário" android:inputType="textNoSuggestions" android:textColor="@color/papel"
                android:textColorHint="#DDE9FF" android:textSize="14sp" android:textStyle="bold" android:paddingHorizontal="20dp"
                android:minHeight="56dp" android:imeOptions="actionNext" android:maxLength="100"/>
            <EditText android:id="@+id/senha" style="@style/Campo" android:layout_marginTop="12dp" android:background="@drawable/campo_login"
                android:hint="Senha de acesso" android:inputType="textPassword" android:textColor="@color/papel"
                android:textColorHint="#DDE9FF" android:textSize="14sp" android:textStyle="bold" android:paddingHorizontal="20dp"
                android:minHeight="56dp" android:saveEnabled="false" android:imeOptions="actionDone"/>
            <Button android:id="@+id/entrar" style="@style/Acao" android:text="Entrar" android:layout_marginTop="12dp" android:minHeight="56dp"/>
            <TextView android:id="@+id/aviso" style="@style/Rotulo" android:accessibilityLiveRegion="polite"
                android:textColor="@color/papel" android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
