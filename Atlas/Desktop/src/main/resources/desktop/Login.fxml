<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.ufg.atlas.desktop.ControleLogin" prefWidth="1080" prefHeight="710" stylesheets="@atlas.css" styleClass="pagina-login">
    <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
    <rowConstraints><RowConstraints percentHeight="100"/></rowConstraints>
    <StackPane>
        <GridPane>
            <columnConstraints><ColumnConstraints percentWidth="22.4"/><ColumnConstraints percentWidth="18.6"/><ColumnConstraints percentWidth="18.4"/><ColumnConstraints percentWidth="18.5"/><ColumnConstraints percentWidth="22.1"/></columnConstraints>
            <rowConstraints><RowConstraints percentHeight="100"/></rowConstraints>
            <Region GridPane.columnIndex="0" styleClass="faixa-1"/>
            <Region GridPane.columnIndex="1" styleClass="faixa-2"/>
            <Region GridPane.columnIndex="2" styleClass="faixa-3"/>
            <Region GridPane.columnIndex="3" styleClass="faixa-4"/>
            <Region GridPane.columnIndex="4" styleClass="faixa-5"/>
        </GridPane>
        <VBox alignment="CENTER" spacing="4" styleClass="boas-vindas">
            <Region VBox.vgrow="ALWAYS"/>
            <StackPane prefHeight="152">
                <ImageView fitWidth="330" preserveRatio="true" accessibleText="ATLAS">
                    <image><Image url="@marca-login.png"/></image>
                </ImageView>
            </StackPane>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Bem-vindo" maxWidth="Infinity" styleClass="saudacao"/>
        </VBox>
    </StackPane>
    <BorderPane GridPane.columnIndex="1">
        <center><VBox alignment="CENTER_LEFT" maxWidth="390" spacing="14" styleClass="credenciais">
            <Label text="Entrar" styleClass="titulo"/>
            <VBox spacing="6"><Label text="Código do funcionário"/>
                <TextField fx:id="codigo" promptText="Código" onAction="#focarSenha"/>
            </VBox>
            <VBox spacing="6"><Label text="Senha"/>
                <PasswordField fx:id="senha" promptText="Senha" onAction="#entrar"/>
            </VBox>
            <Button fx:id="botaoEntrar" text="Entrar" maxWidth="Infinity" defaultButton="true" onAction="#entrar" styleClass="principal"/>
            <Label fx:id="aviso" wrapText="true" maxWidth="Infinity" styleClass="aviso"/>
        </VBox></center>
        <bottom><HBox alignment="CENTER_RIGHT" styleClass="rodape">
            <Button fx:id="botaoConexao" text="Configurar conexão" onAction="#configurar"/>
        </HBox></bottom>
    </BorderPane>
</GridPane>
