<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="10" prefWidth="398" styleClass="formulario">
    <Label text="Nome"/><TextField fx:id="nome"/>
    <Label text="Preço (R$)"/><TextField fx:id="preco" promptText="0,00"/>
    <Label text="Categoria"/><TextField fx:id="categoria"/>
    <Label text="Setor de preparação"/><ComboBox fx:id="setor" maxWidth="Infinity"/>
    <CheckBox fx:id="disponivel" text="Disponível no cardápio" selected="true"/>
</VBox>
