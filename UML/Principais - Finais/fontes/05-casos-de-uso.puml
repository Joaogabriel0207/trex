@startuml
title ATLAS · Casos de uso — Sistema ATLAS
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #172B42
skinparam defaultFontSize 14
skinparam titleFontColor #122E4C
skinparam titleFontSize 24
skinparam shadowing false
skinparam ArrowColor #486778
skinparam noteBackgroundColor #FFF5DD
skinparam noteBorderColor #B59759
skinparam noteFontSize 13
set separator none
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F4F8FC
skinparam packageBorderColor #94ABC0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #5B7893
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam componentStyle uml2
skinparam componentBackgroundColor #EFF6FC
skinparam componentBorderColor #5B7893
skinparam usecaseBackgroundColor #F1F7FC
skinparam usecaseBorderColor #5B7893
skinparam stateBackgroundColor #EFF6FC
skinparam stateBorderColor #5B7893
skinparam nodesep 29
skinparam ranksep 38

top to bottom direction
actor "Garçom" as Garcom
actor "Gerente" as Gerente
actor "Caixa" as Caixa
actor "Operador de\nsalão e caixa" as Operador <<abstrato>>
actor "Operador de\nimplantação" as Implantacao

rectangle "ATLAS" {
  package "Atendimento · Android" {
    usecase "Entrar e sair do Android" as LoginA
    usecase "Consultar mesas,\nconsumo e cardápio" as Consultar
    usecase "Abrir comanda" as Abrir
    usecase "Montar, enviar e\nretomar pedido" as Pedido
    usecase "Consultar pedidos próprios\ne registrar entrega" as Entregar
    usecase "Solicitar conta" as Solicitar
    LoginA -[hidden]down-> Consultar
    Consultar -[hidden]down-> Abrir
    Pedido -[hidden]down-> Entregar
    Entregar -[hidden]down-> Solicitar
  }
  package "Operação · Desktop" {
    usecase "Entrar e sair do Desktop" as LoginD
    usecase "Consultar salão, consumo,\ncontas e comandas encerradas" as Salao
    usecase "Receber valor integral\ne encerrar comanda" as Pagar
    usecase "Consultar panorama, pedidos\ne histórico de entregas" as Painel
    usecase "Administrar mesas,\nprodutos e funcionários" as Cadastro
    usecase "Marcar pedido registrado\ncomo pronto" as Preparo
    usecase "Configurar filas e\nver comprovantes" as Filas
    usecase "Enviar, conferir ou\nrepetir impressão" as Imprimir
    LoginD -[hidden]down-> Salao
    Salao -[hidden]down-> Pagar
    Painel -[hidden]down-> Cadastro
    Cadastro -[hidden]down-> Preparo
    Filas -[hidden]down-> Imprimir
  }
  package "Implantação · Console" {
    usecase "Cadastrar o primeiro\nGERENTE em base vazia" as Primeiro
  }
}
Garcom -down- LoginA
Garcom -down- Consultar
Garcom -down- Abrir
Garcom -down- Pedido
Garcom -down- Entregar
Garcom -down- Solicitar

Caixa -down-|> Operador
Gerente -down-|> Operador
Operador -down- LoginD
Operador -down- Salao
Operador -down- Pagar
Gerente -down- Painel
Gerente -down- Cadastro
Gerente -down- Preparo
Gerente -down- Filas
Gerente -down- Imprimir
Implantacao -down- Primeiro

legend bottom left
  Cargos operacionais precisam estar ativos. Configuração de rede pode ser feita na tela de login.
  A entrega exige pedido próprio em PRONTO. O pagamento exige CONTA_SOLICITADA.
endlegend
@enduml
