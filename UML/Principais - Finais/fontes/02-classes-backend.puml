@startuml
title ATLAS · Classes — Backend e persistência
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #172B42
skinparam defaultFontSize 14
skinparam titleFontColor #122E4C
skinparam titleFontSize 24
skinparam shadowing false
skinparam ArrowColor #486778
skinparam noteBackgroundColor #FFF5DD
skinparam noteBorderColor #B59759
skinparam noteFontSize 13
set separator none
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F4F8FC
skinparam packageBorderColor #94ABC0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #5B7893
skinparam classAttributeIconSize 0
skinparam classAttributeFontSize 14
skinparam componentStyle uml2
skinparam componentBackgroundColor #EFF6FC
skinparam componentBorderColor #5B7893
skinparam usecaseBackgroundColor #F1F7FC
skinparam usecaseBorderColor #5B7893
skinparam stateBackgroundColor #EFF6FC
skinparam stateBorderColor #5B7893
skinparam nodesep 36
skinparam ranksep 47

hide circle
!pragma layout smetana
' O espaço após as multiplicidades separa os rótulos das pontas das setas.
hide empty members
package "br.ufg.atlas.servidor" {
  class Servidor {
    {static} +main(argumentos: String[]): void
  }
  class ApiHttp {
    -avisar: Consumer<String>
    +handle(troca: HttpExchange): void
  }
  class ConexaoBanco {
    ~abrir(): Connection
  }
  class Sessoes {
    ~abrir(codigo: String): String
    ~identificar(token: String): String
    ~encerrar(token: String): void
    ~revogar(codigo: String): void
  }
  class "Sessoes.Sessao" as Sessao <<record>> {
    codigo: String
    validade: long
  }
  class AvisosMqtt {
    ~iniciar(): void
    ~notificar(recurso: String): void
    +close(): void
  }
  class Permissoes {
    {static} ~verificar(pessoa: Funcionario, metodo: String, partes: String[]): void
  }
  class Dados
  class Campos
  class BancoSalao
  class BancoFuncionarios
  class BancoComandas
  class BancoPedidos
  class ConsultaPedidos
  class BancoImpressoes
  class Consultas
  class Senhas
  class ErroHttp {
    -status: int
    ~getStatus(): int
  }
}
interface "HttpHandler" as Handler <<JDK>>
interface AutoCloseable <<JDK>>
class RuntimeException <<JDK>>
ApiHttp .up.|> Handler
AvisosMqtt .up.|> AutoCloseable
ErroHttp -up-|> RuntimeException
Servidor ..> ApiHttp : cria
Servidor ..> AvisosMqtt : cria e liga callback
ApiHttp --> "1  " Sessoes : sessoes
Sessoes *-- "0..*  " Sessao : por token
ApiHttp --> "1  " ConexaoBanco : banco
ApiHttp ..> BancoFuncionarios : login e revalidação
ApiHttp ..> Permissoes : verifica acesso
ApiHttp ..> Dados : executa rota
ApiHttp ..> ErroHttp : status HTTP
Permissoes ..> ErroHttp
Dados ..> Campos : valida entrada
Dados ..> BancoSalao
Dados ..> BancoFuncionarios
Dados ..> BancoComandas
Dados ..> BancoPedidos
Dados ..> ConsultaPedidos
Dados ..> BancoImpressoes
BancoFuncionarios ..> Senhas : gera e confere
BancoPedidos ..> BancoComandas : trava e total
BancoPedidos ..> BancoSalao : produto disponível
BancoComandas ..> ConsultaPedidos : consumo
BancoComandas ..> Consultas
BancoPedidos ..> Consultas
BancoImpressoes ..> Consultas
ConsultaPedidos ..> Consultas
BancoSalao ..> Consultas
BancoFuncionarios ..> Consultas
legend bottom left
  ApiHttp delimita a transação. As classes Banco* e ConsultaPedidos executam o SQL.
  Servidor injeta AvisosMqtt::notificar pelo Consumer<String>.
  Permissoes e as operações JDBC usam classes do Modelo para acesso e validação.
endlegend
@enduml
