J_desktop_Secoes --> "1" J_desktop_ControleListagem : tela
J_desktop_Secoes *-- "1" J_desktop_Operacoes : operacoes
J_desktop_Secoes ..> J_desktop_FilaProducao : producao() cria
J_desktop_Secoes ..> J_desktop_Dados
